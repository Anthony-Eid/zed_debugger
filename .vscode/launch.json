{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Cargo launch",
      "cargo": {
        "args": [
          "build"
        ]
      },
      "args": []
    },
    {
      "type": "lldb-dap",
      "request": "launch",
      "name": "Debug executable 'zed_debugger'",
      "program": "${workspaceFolder}/target/debug/zed_debugger",
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb-dap",
      "request": "attach",
      "name": "Attach 'zed_debugger'",
      "pid": 6955
    },
    {
      "type": "debugpy",
      "request": "attach",
      "name": "python attach",
      "processId": "${command:pickProcess}",
      "logToFile": true
    }
  ]
}
