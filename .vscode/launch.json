{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Rust: build and launch",
      "cargo": {
        "args": [
          "build",
          "--bin",
          "zed_debugger"
        ]
      },
      "args": []
    },
    {
      "type": "lldb-dap",
      "request": "launch",
      "name": "Rust: launch built executable",
      "program": "${workspaceFolder}/target/debug/zed_debugger",
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb-dap",
      "request": "attach",
      "name": "Rust: attach to running process",
      "pid": "${command:pickProcess}"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Python: run examples",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "type": "debugpy",
      "request": "attach",
      "name": "Python: attach to running process",
      "processId": "${command:pickProcess}",
      "logToFile": true
    }
  ]
}
